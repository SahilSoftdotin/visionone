VITE_API_BASE_URL=/api/v1
VITE_OIDC_AUTHORITY=http://localhost:8180/realms/visionone
VITE_OIDC_CLIENT_ID=visionone-web
VITE_OIDC_REDIRECT_URI=http://localhost:5173/

# Optional. How long a CLIENT user may sit idle before VisionOne signs them out, and how much
# warning they get first. Vision Admin is never signed out for inactivity. Both are inlined at
# build time like everything else here, so changing them means rebuilding the web image.
# Omitted or unparseable values fall back to these defaults rather than to zero.
#VITE_IDLE_TIMEOUT_MINUTES=15
#VITE_IDLE_WARNING_SECONDS=60
