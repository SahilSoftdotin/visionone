<mxfile host="app.diagrams.net" agent="VisionOne" version="24.0.0">
  <diagram id="visionone-architecture" name="VisionOne — current architecture">
    <mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1250" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="VisionOne — current architecture" style="text;html=1;fontSize=24;fontStyle=1;fontColor=#2A3547;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="600" height="34" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Solid = carries traffic today.   Dashed = built and wired, but idle." style="text;html=1;fontSize=13;fontColor=#5F6F85;" vertex="1" parent="1">
          <mxGeometry x="40" y="54" width="700" height="24" as="geometry" />
        </mxCell>

        <mxCell id="zclient" value="Browser" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8F9FB;strokeColor=#B1B7C3;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#5F6F85;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="1520" height="150" as="geometry" />
        </mxCell>
        <mxCell id="spa" value="&lt;b&gt;SPA&lt;/b&gt;&lt;br&gt;React 18 · Vite 6 · Tailwind 3&lt;br&gt;react-oidc-context — auth code + PKCE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="70" y="140" width="380" height="90" as="geometry" />
        </mxCell>
        <mxCell id="ovscreen" value="&lt;b&gt;Overview&lt;/b&gt;&lt;br&gt;the only screen that calls the API&lt;br&gt;&lt;font color=&quot;#5F6F85&quot;&gt;fails if the API is down — the canary&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="490" y="140" width="380" height="90" as="geometry" />
        </mxCell>
        <mxCell id="fixtures" value="&lt;b&gt;Growth · Leads · Front Desk&lt;br&gt;Calendar · Work &amp;amp; Content · Reports&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5F6F85&quot;&gt;945 lines of fixtures in the bundle — no network call&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="910" y="140" width="620" height="90" as="geometry" />
        </mxCell>

        <mxCell id="caddy" value="&lt;b&gt;Caddy&lt;/b&gt;   —   TLS · serves the SPA · reverse proxy&lt;br&gt;&lt;font color=&quot;#5F6F85&quot;&gt;demo deployment only; local development hits :5173, :8080 and :8180 directly&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="70" y="300" width="800" height="70" as="geometry" />
        </mxCell>

        <mxCell id="keycloak" value="&lt;b&gt;Keycloak 26&lt;/b&gt;&lt;br&gt;:8180&lt;br&gt;&lt;br&gt;realm: visionone&lt;br&gt;custom login theme&lt;br&gt;CSS-only over keycloak.v2&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#5F6F85&quot;&gt;the only place a credential&lt;br&gt;is ever entered&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;verticalAlign=top;spacingTop=12;" vertex="1" parent="1">
          <mxGeometry x="70" y="430" width="300" height="250" as="geometry" />
        </mxCell>

        <mxCell id="zapi" value="Spring Boot API   :8080   —   modular monolith" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4FAF3;strokeColor=#82B366;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#4F7942;" vertex="1" parent="1">
          <mxGeometry x="420" y="410" width="1140" height="460" as="geometry" />
        </mxCell>

        <mxCell id="l1" value="&lt;b&gt;①&lt;/b&gt;  auth.SecurityConfig&lt;br&gt;validate JWT · map realm roles" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="450" y="450" width="290" height="55" as="geometry" />
        </mxCell>
        <mxCell id="l2" value="&lt;b&gt;②&lt;/b&gt;  OrganizationContextInterceptor&lt;br&gt;resolve {orgId} · check membership" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="450" y="525" width="290" height="55" as="geometry" />
        </mxCell>
        <mxCell id="l3" value="&lt;b&gt;③&lt;/b&gt;  tenant-scoped repositories&lt;br&gt;every query bound to organization_id" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="450" y="600" width="290" height="55" as="geometry" />
        </mxCell>
        <mxCell id="layersnote" value="three independent layers — no single&lt;br&gt;missed check exposes another tenant" style="text;html=1;fontSize=10;fontColor=#5F6F85;align=center;" vertex="1" parent="1">
          <mxGeometry x="450" y="660" width="290" height="30" as="geometry" />
        </mxCell>

        <mxCell id="controllers" value="&lt;b&gt;Controllers&lt;/b&gt;&lt;br&gt;/me · /meta · /overview&lt;br&gt;&lt;font color=&quot;#5F6F85&quot;&gt;the entire REST surface&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="790" y="450" width="290" height="70" as="geometry" />
        </mxCell>
        <mxCell id="ovsvc" value="&lt;b&gt;OverviewService&lt;/b&gt;&lt;br&gt;&lt;br&gt;LeadMetrics · AppointmentMetrics&lt;br&gt;GrowthFinance · WorkActivity&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#5F6F85&quot;&gt;injected by interface — reference&lt;br&gt;counters report these unused, wrongly&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="790" y="545" width="290" height="145" as="geometry" />
        </mxCell>

        <mxCell id="ports" value="&lt;b&gt;integration — ports&lt;/b&gt;&lt;br&gt;&lt;br&gt;SchedulingProvider   ← Healthie&lt;br&gt;VoiceProvider&lt;br&gt;AdvertisingProvider&lt;br&gt;AnalyticsProvider&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#B85450&quot;&gt;&lt;b&gt;all four report DEMO&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#5F6F85&quot;&gt;this port is the PHI boundary:&lt;br&gt;an external ref, a time and a status —&lt;br&gt;never a patient name&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="1120" y="450" width="410" height="240" as="geometry" />
        </mxCell>

        <mxCell id="eventing" value="&lt;b&gt;eventing&lt;/b&gt;   —   &lt;font color=&quot;#5F6F85&quot;&gt;Postgres is the queue&lt;/font&gt;&lt;br&gt;DomainEventPublisher  →  outbox_event  →  OutboxDispatcher" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B1B7C3;dashed=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="450" y="730" width="630" height="60" as="geometry" />
        </mxCell>
        <mxCell id="auditc" value="&lt;b&gt;audit&lt;/b&gt;&lt;br&gt;AuditEventHandler&lt;br&gt;&lt;font color=&quot;#5F6F85&quot;&gt;the only handler&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B1B7C3;dashed=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1120" y="730" width="410" height="60" as="geometry" />
        </mxCell>

        <mxCell id="pg" value="&lt;b&gt;PostgreSQL 17&lt;/b&gt;&lt;br&gt;&lt;br&gt;keycloak DB — realm, users, sessions&lt;br&gt;visionone DB — 19 tables, 13 queried today&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#5F6F85&quot;&gt;not optional at any point: Keycloak lives here, so the&lt;br&gt;container stays even if the application stored nothing&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=12;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="70" y="920" width="620" height="200" as="geometry" />
        </mxCell>
        <mxCell id="ext" value="&lt;b&gt;External systems&lt;/b&gt;&lt;br&gt;&lt;br&gt;Healthie · voice · ad platforms · analytics&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#B85450&quot;&gt;none connected —&lt;br&gt;every adapter is a Demo* class&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B1B7C3;dashed=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1150" y="920" width="380" height="200" as="geometry" />
        </mxCell>

