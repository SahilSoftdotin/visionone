# Copy to .env.prod ON THE SERVER and fill in. .env.prod is gitignored and must stay that way -
# these are real credentials for a host on the public internet, not the throwaway values in
# docker-compose.yml.
#
# Generate each secret with:  openssl rand -base64 24

# The hostname the portal answers on. A bare host, no scheme, no trailing slash. It must already
# resolve to this server on ports 80 and 443 before the first start, or Caddy cannot be issued a
# certificate.
DOMAIN=app.visiondigitallab.com

# Where Let's Encrypt sends expiry warnings.
ACME_EMAIL=sahil@visiondigitallab.com

# Postgres. Used by both the API and Keycloak.
POSTGRES_PASSWORD=

# Keycloak's own admin console. Not routed publicly - reach it over an SSH tunnel.
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=

# The two sign-ins, substituted into the realm at deploy time. Minimum 8 characters; the renderer
# refuses anything shorter or empty. These replace vision123 and thrive123, which are fine on a
# laptop and indefensible on a URL you are sending to a client.
#
# These seed the realm on FIRST IMPORT ONLY. Changing them here does nothing to a running system -
# see "Changing a password" in docs/deployment.md. Keep them in step anyway, so a realm rebuilt from
# an empty database comes back with the password you expect.
VISIONONE_DEMO_PASSWORD_SAHIL=
VISIONONE_DEMO_PASSWORD_GARY=

# Where a password reset actually lands. Optional, and deliberately not committed: the real
# addresses are not ours to publish, and this repository is public. Unset, each account keeps the
# role address in the committed realm, which is right for development and wrong for a live reset.
#VISIONONE_DEMO_EMAIL_SAHIL=hello@visiondigitallab.com
#VISIONONE_DEMO_EMAIL_GARY=

# Which published images to run. Built by .github/workflows/images.yml on every push to main and
# pushed to GHCR. Leave IMAGE_TAG unset to track `latest`, or pin the full 40-character commit SHA to
# run one exact build - which is also how you roll back: set it to the previous SHA and `make deploy`.
#IMAGE_REGISTRY=ghcr.io/sahilsoftdotin
#IMAGE_TAG=latest

# The images are private even though the repository is public - package visibility is a separate
# setting and does not follow the repo. So the server has to authenticate once before the first pull.
# Do this on the box, not here: it writes to /root/.docker/config.json, and the token must never land
# in a file in the repo, least of all a public one.
#
# You could instead make the two packages public and skip this entirely. Keeping them private costs
# one token and means nobody can pull and run your build; with the source public anyway, that is a
# preference rather than a security boundary.
#
#   echo <TOKEN> | docker login ghcr.io -u SahilSoftdotin --password-stdin
#
# TOKEN is a GitHub personal access token with the single scope read:packages. Nothing more: this
# token only ever pulls images, so it has no business being able to push code or read the repository.

# Outbound mail, which is what makes "Forgot password?" real rather than a link that errors. This
# is a Resend API key; the SMTP username is the literal string "resend", which is Resend's own
# scheme and not a placeholder. The sending domain must be verified with Resend first or every send
# is rejected.
#
# Setting this is what turns resetPasswordAllowed on: the renderer keeps the link and the mail
# server together, so there is no state where the link is offered with nowhere to send to. Leave it
# blank and the link is simply not rendered.
VISIONONE_SMTP_PASSWORD=
#VISIONONE_SMTP_HOST=smtp.resend.com
#VISIONONE_SMTP_PORT=587
#VISIONONE_SMTP_USER=resend
#VISIONONE_SMTP_FROM=noreply@visiondigitallab.com
#VISIONONE_SMTP_REPLY_TO=hello@visiondigitallab.com

# Optional. How long a CLIENT user may sit idle in the browser before VisionOne signs them out,
# and how much warning they get first. Vision Admin is never signed out for inactivity.
#
# These are served to the browser on /me rather than compiled into the web image, so changing one
# takes a `docker compose up -d api` and no rebuild. Fifteen minutes is what a healthcare security
# questionnaire expects; clinical systems use ten to fifteen, general dashboards thirty to sixty.
# Zero or less is corrected to the default at startup and logged, because a timeout of zero means
# a deadline of now - every client signed out the moment they arrive.
#VISIONONE_SESSION_IDLE_MINUTES=15
#VISIONONE_SESSION_WARNING_SECONDS=60

# Optional. How often the two event schedulers wake, in milliseconds. Both default to hourly in
# docker-compose.prod.yml, which is the right setting for a marketing dashboard: a Healthie webhook
# is still accepted the moment it arrives - the endpoint verifies it, writes one inbox row and
# returns - and only the draining of that row waits. Uncomment and lower either if something turns
# out to need fresher figures than an hour.
#VISIONONE_EVENTING_INBOX_INTERVAL_MS=3600000
#VISIONONE_EVENTING_DISPATCHER_INTERVAL_MS=3600000
