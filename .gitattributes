# Normalise to LF in the repository; check out native on Windows.
* text=auto

# Scripts that run on Linux (CI, containers) must keep LF regardless of platform.
*.sh        text eol=lf
gradlew     text eol=lf
Makefile    text eol=lf

# Windows-only scripts keep CRLF.
*.bat       text eol=crlf
*.ps1       text eol=crlf

# Never touch binaries.
*.jar       binary
*.png       binary
*.jpg       binary
*.woff2     binary
